    <section id="service.subtitle.enforcer">
        <category id="general" label="32000" help="32001">
            <group id="1" label="32002">
                <setting id="enabled" type="boolean" label="32003" help="32004">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
            </group>
            <group id="2" label="32005">
                <setting id="sync_enabled" type="boolean" label="32006" help="32007">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
                <setting id="sync_wait" type="integer" label="32008" help="32009">
                    <level>0</level>
                    <default>5</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>30</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="sync_enabled">true</dependency>
                    </dependencies>
                    <control type="spinner" format="integer" />
                </setting>
                <setting id="sync_seek" type="integer" label="32010" help="32011">
                    <level>0</level>
                    <default>1</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>15</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="sync_enabled">true</dependency>
                    </dependencies>
                    <control type="spinner" format="integer" />
                </setting>
            </group>
            <group id="3" label="32012">
                <setting id="audio_mode" type="string" label="32013" help="32014">
                    <level>0</level>
                    <default>forced</default>
                    <constraints>
                        <options>
                            <option label="Use forced subtitles only">forced</option>
                            <option label="Turn subtitles off">off</option>
                            <option label="Choose a subtitle as usual">usual</option>
                        </options>
                    </constraints>
                    <control type="list" format="string" />
                </setting>
                <setting id="disable_on_miss" type="boolean" label="32015" help="32016">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
            </group>
            <group id="4" label="32017">
                <setting id="notify" type="boolean" label="32018" help="32019">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle" />
                </setting>
            </group>
